# Build output. Regenerated by `npm run build`; formatting it is churn.
dist/

# Runtime crawl output — other people's website content, gitignored anyway.
work/

# Vendored data. `schema-subclasses.json` and `schema-context.json` are
# generated by tools/ from schema.org and must stay byte-comparable with their
# source; the hand-written rule files carry deliberate alignment and comment
# blocks that Prettier would flatten into something harder to edit.
data/

node_modules/
package-lock.json

# Markdown is left alone on purpose. Every document here is hand-wrapped prose
# with tables aligned by hand, and Prettier reflows both — a 2,000-line diff
# across docs/ that changes no meaning and makes `git blame` useless on the
# files most likely to need it.
*.md
